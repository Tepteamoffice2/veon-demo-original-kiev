---
import Section from "./Section.astro";
import FutureLink from "./FutureLink.astro";
import Icon from "./Icon.astro";
import { contacts, soon } from "../data/site";

const stops = [
  { place: "Самовивіз", head: "Оболонь, Героїв Дніпра, 67А", text: "Пн–Пт 9:00–19:00, Сб 9:00–15:00." },
  { place: "По Києву", head: "У день замовлення", text: "Термінова доставка — лише по Києву." },
  { place: "Нова пошта", head: "1–3 дні по Україні", text: "Відправка протягом 1 робочого дня після підтвердження, у відділення або на адресу." },
];
---
<Section id="delivery" rec="R-004" class="delivery">
  <div class="container">
    <div class="section-head">
      <h2>Від прилавка на&nbsp;Оболоні&nbsp;— до&nbsp;вашого міста</h2>
      <p>Забрати самому, отримати сьогодні по Києву або Новою поштою по всій Україні.</p>
    </div>

    <ol class="route" role="list" data-reveal>
      {stops.map((s, i) => (
        <li class="route__stop" style={`--n:${i}`}>
          <span class="route__dot" aria-hidden="true"></span>
          <p class="route__place">{s.place}</p>
          <h3 class="route__head">{s.head}</h3>
          <p class="route__text">{s.text}</p>
        </li>
      ))}
    </ol>

    <div class="pay">
      <h3 class="pay__title">Оплата</h3>
      <p class="pay__text">
        Готівкою в магазині, накладеним платежем (+3%), передоплата 20% для резерву, P2P-переказ, онлайн через LiqPay або на рахунок ФОП для юросіб. Передоплачені замовлення обробляємо першими. Вартість доставки — за тарифами перевізника.
      </p>
      <div class="pay__links">
        <FutureLink note={soon} class="future-link--text">Доставка та оплата докладно</FutureLink>
        <a class="text-link" href="#guarantee">Гарантія і повернення</a>
      </div>
      <a class="btn btn--outline desk-only pay__ask" href={contacts.viber}><Icon name="viber" />Уточнити доставку у Viber</a>
    </div>
  </div>
</Section>

<style>
  .delivery { background: var(--color-surface); padding-block: var(--section-pad-lg); }
  .delivery .section-head { max-width: 52rem; }

  /* One route: from the counter at 67А to the visitor's city. */
  .route {
    position: relative; list-style: none; margin: var(--s-9) 0 0; padding: 0;
    display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: var(--s-6);
  }
  .route::before {
    content: "";
    position: absolute; left: 0; right: 0; top: 7px; height: 2px;
    background: var(--color-text); transform-origin: left center;
  }
  .route__stop { position: relative; display: grid; gap: var(--s-2); padding-top: var(--s-7); align-content: start; }
  .route__dot {
    position: absolute; top: 0; left: 0; width: 16px; height: 16px;
    background: var(--color-accent); border: 3px solid var(--color-surface);
    clip-path: polygon(30% 0, 70% 0, 100% 50%, 70% 100%, 30% 100%, 0 50%);
  }
  .route__stop:first-child .route__dot { width: 24px; height: 24px; top: -4px; left: -4px; }
  .route__place { font-weight: 600; color: var(--color-accent-hover); }
  .route__head { font-size: var(--fs-h3); font-weight: 700; line-height: 1.1; }
  .route__text { color: var(--color-muted); max-width: 32ch; }

  .pay {
    margin-top: var(--s-9); padding-top: var(--s-6); border-top: 1px solid var(--color-line-strong);
    display: grid; grid-template-columns: repeat(12, minmax(0, 1fr)); gap: var(--s-3) var(--s-5);
  }
  .pay__title { grid-column: 1 / span 3; font-family: var(--font-body); font-size: var(--fs-body); font-weight: 600; }
  .pay__text { grid-column: 4 / span 7; font-size: var(--fs-lede); line-height: 1.5; }
  .pay__ask { grid-column: 4 / -1; justify-self: start; margin-top: var(--s-4); }
  .pay__links { grid-column: 4 / -1; display: flex; flex-wrap: wrap; gap: var(--s-2) var(--s-6); margin-top: var(--s-2); }

  /* Motion: the line grows from the counter, the stops follow (only with scripts and motion allowed). */
  :global(.js) .route[data-reveal]:not(.is-visible) { opacity: 1; transform: none; }
  @media (prefers-reduced-motion: no-preference) {
    :global(.js) .route::before { transition: transform 700ms var(--ease-out); }
    :global(.js) .route .route__stop { transition: opacity 400ms var(--ease-out); transition-delay: calc(250ms + var(--n) * 180ms); }
    :global(.js) .route:not(.is-visible)::before { transform: scaleX(0); }
    :global(.js) .route:not(.is-visible) .route__stop:not(:first-of-type) { opacity: 0; }
  }

  @media (max-width: 767.98px) {
    .route { grid-template-columns: minmax(0, 1fr); gap: var(--s-6); margin-top: var(--s-7); padding-left: var(--s-6); }
    .route::before { left: 7px; right: auto; top: 0; bottom: 0; width: 2px; height: auto; transform-origin: center top; }
    .route__stop { padding-top: 0; }
    .route__dot { left: calc(-1 * var(--s-6)); top: 4px; }
    .route__stop:first-child .route__dot { left: calc(-1 * var(--s-6) - 4px); top: 0; }
    .pay { grid-template-columns: minmax(0, 1fr); margin-top: var(--s-7); }
    .pay__title, .pay__text, .pay__links { grid-column: 1; }
  }
  @media (max-width: 767.98px) and (prefers-reduced-motion: no-preference) {
    :global(.js) .route::before { transition-duration: 500ms; }
    :global(.js) .route:not(.is-visible)::before { transform: scaleY(0); }
  }
</style>
