---
import { Picture } from "astro:assets";
import logo from "../assets/logo-original-kiev.png";
import FutureLink from "./FutureLink.astro";
import { contacts, soon } from "../data/site";

const pages = ["Про магазин", "F.A.Q.", "Кабінет клієнта", "Публічна оферта", "Політика конфіденційності"];
---
<footer class="site-footer on-ink">
  <div class="container site-footer__grid">
    <div class="site-footer__brand">
      <a class="site-footer__logo" href="#top" aria-label="Original Kiev, на початок сторінки">
        <Picture src={logo} formats={["avif", "webp"]} alt="" width={60} height={49} loading="lazy" data-rec="R-009" />
      </a>
      <p>Original Kiev, автозапчастини з 2016 року.</p>
      <p class="site-footer__legal">{contacts.legal}</p>
    </div>
    <nav aria-label="Сторінки сайту">
      <ul class="site-footer__list" role="list">
        {pages.map((p) => <li><FutureLink note={soon} class="site-footer__link">{p}</FutureLink></li>)}
      </ul>
    </nav>
    <div>
      <ul class="site-footer__list" role="list">
        <li><a class="site-footer__a" href={contacts.phoneMain.href}>{contacts.phoneMain.label}</a></li>
        <li><a class="site-footer__a" href={contacts.phoneSecond.href}>{contacts.phoneSecond.label}</a></li>
        <li><a class="site-footer__a" href={contacts.email.href}>{contacts.email.label}</a></li>
        <li class="site-footer__addr">{contacts.addressFull}</li>
      </ul>
    </div>
  </div>
</footer>

<style>
  .site-footer { background: var(--color-ink); color: var(--color-on-dark); padding-block: var(--s-8) var(--s-7); }
  .site-footer__grid { display: grid; grid-template-columns: repeat(12, minmax(0, 1fr)); gap: var(--s-6) var(--s-5); }
  .site-footer__grid > :nth-child(1) { grid-column: 1 / span 5; }
  .site-footer__grid > :nth-child(2) { grid-column: 6 / span 3; }
  .site-footer__grid > :nth-child(3) { grid-column: 9 / -1; }
  .site-footer__brand { display: grid; gap: var(--s-3); align-content: start; }
  .site-footer__logo { display: inline-flex; justify-self: start; background: var(--color-on-dark); padding: var(--s-2); }
  .site-footer__logo :global(img) { width: 60px; height: auto; }
  .site-footer__legal { color: var(--color-on-dark-muted); font-size: var(--fs-small); }
  .site-footer__list { list-style: none; margin: 0; padding: 0; display: grid; }
  .site-footer :global(.site-footer__link) { min-height: var(--tap); color: var(--color-on-dark-muted); }
  .site-footer :global(.site-footer__link:hover) { color: var(--color-on-dark); }
  .site-footer :global(.future-link__note[aria-hidden="true"]) { left: 0; transform: translate(0, -4px); background: var(--color-on-dark); color: var(--color-ink); }
  .site-footer :global(.future-link:hover .future-link__note), .site-footer :global(.future-link:focus-visible .future-link__note) { transform: translate(0, 0); }
  .site-footer__a { display: inline-flex; align-items: center; min-height: var(--tap); text-decoration: none; font-weight: 600; overflow-wrap: anywhere; }
  .site-footer__a:hover { text-decoration: underline; }
  .site-footer__addr { color: var(--color-on-dark-muted); font-size: var(--fs-small); padding-top: var(--s-2); }

  @media (max-width: 767.98px) {
    .site-footer__grid > :nth-child(n) { grid-column: 1 / -1; }
    .site-footer { padding-bottom: calc(var(--s-7) + var(--bar-h)); }
  }
</style>
