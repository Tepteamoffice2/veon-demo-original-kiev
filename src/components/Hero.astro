---
import Section from "./Section.astro";
import VinStrip from "./VinStrip.astro";
---
<Section id="vin" rec="R-001" class="hero on-red">
  <div class="container hero__inner">
    <h1 class="hero__title" data-rec="R-018">Автозапчастини <span class="nobr">за VIN-кодом</span> у&nbsp;Києві</h1>
    <p class="hero__lede">Надішліть VIN у&nbsp;Viber чи Telegram&nbsp;— підберемо оригінал або якісний аналог безкоштовно.</p>
    <div class="hero__vin">
      <VinStrip id="vin-code" />
    </div>
    <aside class="send" aria-labelledby="send-title">
      <div class="send__title" id="send-title">Що надіслати</div>
      <ul class="send__list" role="list">
        <li>VIN-код із техпаспорта</li>
        <li>Марку, модель і рік авто</li>
        <li>Назву деталі або її фото</li>
      </ul>
    </aside>
  </div>
</Section>

<style>
  .hero {
    background: var(--color-accent);
    color: var(--color-accent-ink);
    min-height: min(calc(100svh - var(--header-h)), 860px);
    display: flex; align-items: center;
    padding-block: var(--s-7) var(--s-8);
  }
  .hero__inner { display: grid; grid-template-columns: repeat(12, minmax(0, 1fr)); column-gap: var(--s-5); row-gap: var(--s-5); }
  .hero__title {
    grid-column: 1 / span 10;
    font-size: var(--fs-h1); line-height: 1; font-weight: 700; letter-spacing: -0.015em;
  }
  .hero__lede { grid-column: 1 / span 7; font-size: var(--fs-lede); line-height: 1.4; max-width: 36ch; }
  .hero__vin { grid-column: 1 / span 9; margin-top: var(--s-4); }
  .send {
    grid-column: 10 / -1; align-self: start; margin-top: calc(var(--s-4) + 2rem);
    background: var(--color-on-dark); color: var(--color-ink);
    padding: var(--s-5); display: grid; gap: var(--s-3);
  }
  .send__title { font-family: var(--font-body); font-size: var(--fs-body); font-weight: 600; line-height: 1.3; }
  .send__list { list-style: none; margin: 0; padding: 0; display: grid; }
  .send__list li { padding-block: var(--s-2); border-top: 1px solid var(--color-line); line-height: 1.35; }
  @media (max-width: 1023.98px) {
    .hero__vin, .send { grid-column: 1 / -1; }
    .send { margin-top: 0; }
  }

  @media (max-width: 767.98px) {
    .hero { padding-block: var(--s-6) var(--s-7); align-items: flex-start; min-height: 0; }
    .hero__inner { grid-template-columns: minmax(0, 1fr); row-gap: var(--s-4); }
    .hero__title, .hero__lede, .hero__vin, .send { grid-column: 1 / -1; }
    .send { background: transparent; color: inherit; padding: var(--s-4) 0 0; border-top: 1px solid var(--color-line-on-dark); gap: var(--s-2); }
    .send__list { grid-template-columns: minmax(0, 1fr); }
    .send__list li { border: 0; padding-block: var(--s-1); font-size: var(--fs-small); }
    .send__list li::before { content: ""; display: inline-block; width: 6px; height: 6px; margin-right: var(--s-2); vertical-align: middle; background: currentColor; }
    .hero__vin { margin-top: var(--s-2); }
  }
</style>
