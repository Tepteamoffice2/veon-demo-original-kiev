---
// Functional line icons only (2px stroke, 24 grid). Decorative: always aria-hidden, the control carries the name.
type Name = "viber" | "telegram" | "phone" | "route" | "menu" | "close" | "copy" | "mail";
interface Props { name: Name; size?: number; class?: string; }
const { name, size = 22, class: cls } = Astro.props;
---
<svg class:list={["icon", cls]} width={size} height={size} viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false">
  {name === "viber" && (
    <>
      <path d="M12 2.8c-4.9 0-8.2 2.2-8.2 7.7 0 3.1 1 5.1 2.9 6.2v3.9l3-2.6c.8.1 1.5.2 2.3.2 4.9 0 8.2-2.2 8.2-7.7S16.9 2.8 12 2.8Z" />
      <path d="M9.2 7.6c.4-.3.9-.3 1.1.1l.7 1.3c.2.4.1.8-.2 1.1l-.4.3c.4 1 1.2 1.8 2.2 2.2l.3-.4c.3-.3.7-.4 1.1-.2l1.3.7c.4.2.5.7.1 1.1-.6.7-1.4 1-2.3.7-2-.7-3.6-2.3-4.3-4.3-.2-.8 0-1.7.4-2.1Z" stroke-width="1.6" />
    </>
  )}
  {name === "telegram" && <path d="M21 4 3 11.2l6.6 2.3m11.4-9.5-3.2 16-8.2-6.5m11.4-9.5L9.6 13.5m0 0 .4 5.5 2.8-3.1" />}
  {name === "phone" && <path d="M5 3.5h3.3l1.6 4.2-2.1 1.4a11 11 0 0 0 7.1 7.1l1.4-2.1 4.2 1.6V19a1.6 1.6 0 0 1-1.7 1.6A16.6 16.6 0 0 1 3.4 5.2 1.6 1.6 0 0 1 5 3.5Z" />}
  {name === "route" && (
    <>
      <path d="M12 21s-6.5-6-6.5-11a6.5 6.5 0 0 1 13 0c0 5-6.5 11-6.5 11Z" />
      <circle cx="12" cy="10" r="2.4" />
    </>
  )}
  {name === "menu" && <path d="M4 7h16M4 12h16M4 17h16" />}
  {name === "close" && <path d="M6 6l12 12M18 6 6 18" />}
  {name === "copy" && (
    <>
      <rect x="8.5" y="8.5" width="11.5" height="11.5" />
      <path d="M15.5 8.5V4H4v11.5h4.5" />
    </>
  )}
  {name === "mail" && (
    <>
      <rect x="3" y="5" width="18" height="14" />
      <path d="m3.5 6 8.5 7 8.5-7" />
    </>
  )}
</svg>
